{
  "name": "ii-smetchik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ИИ Сметчик — расчёт стоимости ремонтных работ по проектной документации",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "start": "node dist/server/main.js",
    "start:worker": "node dist/worker/main.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "pricelist:import": "tsx src/domain/pricelist/import-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "estimate:preview": "tsx src/domain/estimate/preliminary-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.8.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
