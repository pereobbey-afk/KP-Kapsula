# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Реальные ключи храните в хранилище секретов хостинга, а не в репозитории.

# --- Сервер ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Публичный адрес приложения (для ссылок и cookie)
PUBLIC_URL=http://localhost:3000

# --- Хранилище ---
# Путь к файлу БД SQLite. Каталог должен быть на постоянном диске.
DATABASE_PATH=./data/ii-smetchik.sqlite
# Каталог для загруженных файлов
STORAGE_DIR=./storage

# --- Сессии ---
# Случайная строка >=32 символов. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=
# Время жизни сессии интерфейса. Задача расчёта переживает её истечение.
SESSION_TTL_HOURS=12

# --- ИИ API ---
# Ключ Anthropic. НИКОГДА не коммитить.
ANTHROPIC_API_KEY=
# Модель для извлечения фактов из документации
EXTRACTION_MODEL=claude-opus-5

# --- Ограничения загрузки ---
# Фактический лимит размера одного файла, байт (по умолчанию 64 МБ)
MAX_FILE_BYTES=67108864
# Максимум файлов в одном расчёте
MAX_FILES_PER_JOB=20
# Размер части при поэтапной загрузке, байт
UPLOAD_CHUNK_BYTES=1048576

# --- Фоновые задачи ---
# Сколько задач воркер берёт одновременно
WORKER_CONCURRENCY=2
# Аренда задачи: если воркер умер, задача вернётся в очередь через это время, сек
JOB_LEASE_SECONDS=120
# Полный тайм-аут задачи, сек
JOB_TIMEOUT_SECONDS=1800
# Максимум попыток при временных ошибках
JOB_MAX_ATTEMPTS=3
# TTL загруженных файлов, часов (не раньше, чем пользователь получит результат)
UPLOAD_TTL_HOURS=168
